console.log("Media Downloader for X Loaded");

// Inject the interceptor script to access window.fetch and window.XMLHttpRequest
const script = document.createElement('script');
script.src = chrome.runtime.getURL('x_interceptor.js');
script.onload = function() {
    this.remove();
};
(document.head || document.documentElement).appendChild(script);

// SVG for the Download Button
const downloadSvg = `
<svg viewBox="0 0 24 24" aria-hidden="true" style="width: 18.75px; height: 18.75px; fill: currentColor;">
    <g>
        <path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8z"></path>
        <path d="M12 16l4-4h-3V8h-2v4H8l4 4z"></path>
    </g>
</svg>
`;

function injectDownloadButtons() {
    // Find all tweet action groups that don't have our button yet
    const actionGroups = document.querySelectorAll('[role="group"]:not(.md-injected-x)');
    
    actionGroups.forEach(group => {
        // Ensure this is a tweet action group (usually has Reply, Repost, Like buttons)
        const replyBtn = group.querySelector('[data-testid="reply"]');
        const likeBtn = group.querySelector('[data-testid="like"]') || group.querySelector('[data-testid="unlike"]');
        
        // Group might be the main action bar
        if (replyBtn) {
            group.classList.add('md-injected-x');
            
            // Find the closest article or tweet container to get the tweet URL/ID
            const article = group.closest('article');
            let tweetId = null;
            
            if (article) {
                // Try to find the time element link
                const timeElements = article.querySelectorAll('time');
                for (let timeEl of timeElements) {
                    const link = timeEl.closest('a');
                    if (link && link.href) {
                        const urlMatch = link.href.match(/status\/(\d+)/);
                        if (urlMatch) {
                            tweetId = urlMatch[1];
                            break;
                        }
                    }
                }
            }
            
            // If we couldn't find it via time link, check URL if it's a dedicated page
            if (!tweetId) {
                const urlMatch = window.location.href.match(/status\/(\d+)/);
                if (urlMatch) tweetId = urlMatch[1];
            }
            
            if (!tweetId) return; // Cannot map to video without tweet ID
            
            // Clone any action button as a template (reply button is always present)
            const templateBtn = replyBtn;
            if (!templateBtn) return;
            
            // The template button usually has a wrapper. Let's find the outermost element that represents the button cell
            let buttonWrapper = templateBtn;
            // Go up until the parent is the group
            while (buttonWrapper && buttonWrapper.parentElement !== group) {
                buttonWrapper = buttonWrapper.parentElement;
            }
            
            if (!buttonWrapper || buttonWrapper === group) return;
            
            const clone = buttonWrapper.cloneNode(true);
            clone.classList.add('md-download-btn');
            
            // Replace the SVG
            const svgElement = clone.querySelector('svg');
            if (svgElement) {
                svgElement.outerHTML = downloadSvg;
            }
            
            // Clear any text if it copied numbers (like reply count)
            const spanText = clone.querySelector('span');
            if (spanText) spanText.textContent = '';
            
            // Attach click event
            clone.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                // Animate button
                const innerSvg = clone.querySelector('svg');
                if (innerSvg) {
                    innerSvg.style.transform = 'scale(0.8)';
                    setTimeout(() => innerSvg.style.transform = 'scale(1)', 150);
                }
                
                // Request video URL from interceptor
                window.postMessage({
                    action: "GET_X_VIDEO",
                    tweetId: tweetId
                }, "*");
            });
            
            // Insert it before the share button or at the end
            const bookmarkBtn = group.querySelector('[data-testid="bookmark"]') || group.querySelector('[data-testid="removeBookmark"]');
            const shareBtn = group.querySelector('[aria-label="Share Tweet"], [aria-label="Share post"]');
            
            // To be safe with react DOM structure, append directly to group if we can't find an exact anchor
            let insertAnchor = null;
            if (bookmarkBtn) {
                 let curr = bookmarkBtn;
                 while(curr && curr.parentElement !== group) curr = curr.parentElement;
                 insertAnchor = curr;
            } else if (shareBtn) {
                 let curr = shareBtn;
                 while(curr && curr.parentElement !== group) curr = curr.parentElement;
                 insertAnchor = curr;
            }
            
            if (insertAnchor && insertAnchor.nextSibling) {
                // Insert after bookmark or share button
                group.insertBefore(clone, insertAnchor.nextSibling);
            } else {
                group.appendChild(clone);
            }
        }
    });
}

// Listen for video result from the interceptor
window.addEventListener("message", (event) => {
    if (event.source !== window || !event.data || event.data.action !== "X_VIDEO_RESULT") return;
    
    const tweetId = event.data.tweetId;
    const videoUrl = event.data.videoUrl;
    
    if (videoUrl) {
        console.log(`Sending download request for X video (Tweet: ${tweetId}):`, videoUrl);
        // We pass it directly to background.js with direct_metadata so yt-dlp downloads the direct URL
        // using the generic extractor, avoiding Twitter cookies!
        chrome.runtime.sendMessage({
            action: "queue_download",
            url: window.location.href, // Dummy, not used if direct_metadata is provided
            account: "twitter_user",
            mediaType: "video",
            platform: "twitter",
            direct_metadata: {
                url: videoUrl,
                is_direct: true,
                ext: "mp4",
                tweet_id: tweetId
            }
        }, (response) => {
            console.log("Download queued:", response);
        });
    } else {
        alert("Video URL not captured yet. Please play the video for a second and try again!");
    }
});

// Run injector on mutations
function initX() {
    if (!document.body) {
        setTimeout(initX, 100);
        return;
    }
    
    const observer = new MutationObserver((mutations) => {
        injectDownloadButtons();
    });

    observer.observe(document.body, { childList: true, subtree: true });

    // Initial run
    setTimeout(injectDownloadButtons, 2000);
}

initX();
