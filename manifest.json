{
  "manifest_version": 3,
  "name": "Media Downloader Dev",
  "version": "1.0",
  "description": "Download media from Instagram, Facebook, and X directly to your PC.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "webRequest",
    "downloads",
    "downloads.ui",
    "downloads.shelf"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://web.telegram.org/*",
    "*://webk.telegram.org/*",
    "*://webz.telegram.org/*",
    "*://*.fbcdn.net/*",
    "*://*.cdninstagram.com/*",
    "*://*.googleusercontent.com/*",
    "*://photos.google.com/*",
    "*://*.icloud.com/*",
    "*://*.icloud-content.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "dist/ig_interceptor.bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/shared/utils/error_reporter.js",
        "src/shared/utils/toast_manager.js",
        "src/shared/utils/dom_observer.js",
        "src/shared/utils/shortcut_manager.js",
        "src/shared/utils/filename_formatter.js",
        "dist/ig_content.bundle.js"
      ],
      "css": [
        "src/shared/styles/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "src/shared/utils/error_reporter.js",
        "src/shared/utils/toast_manager.js",
        "src/shared/utils/dom_observer.js",
        "src/shared/utils/shortcut_manager.js",
        "src/shared/utils/filename_formatter.js",
        "src/x/x_buttons.js",
        "src/x/main.js"
      ],
      "css": [
        "src/shared/styles/content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/shared/utils/error_reporter.js",
        "src/shared/utils/toast_manager.js",
        "src/shared/utils/dom_observer.js",
        "src/shared/utils/shortcut_manager.js",
        "src/shared/utils/filename_formatter.js",
        "src/facebook/utils/metadata_parser.js",
        "src/facebook/features/ghost_mode.js",
        "src/facebook/features/story_buttons.js",
        "src/facebook/features/theater_buttons.js",
        "src/facebook/main.js"
      ],
      "css": [
        "src/shared/styles/content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://web.telegram.org/*",
        "*://webk.telegram.org/*",
        "*://webz.telegram.org/*"
      ],
      "js": [
        "src/shared/utils/error_reporter.js",
        "src/shared/utils/toast_manager.js",
        "src/shared/utils/dom_observer.js",
        "src/shared/utils/shortcut_manager.js",
        "src/shared/utils/filename_formatter.js",
        "src/telegram/core/tg_interceptor_init.js",
        "src/telegram/utils/mp4_remux.js",
        "src/telegram/utils/metadata_parser.js",
        "src/telegram/utils/media_resolver.js",
        "src/telegram/core/media_capture.js",
        "src/telegram/core/network_downloader.js",
        "src/telegram/ui/progress_toast.js",
        "src/telegram/features/universal_interceptor.js",
        "src/telegram/features/webz_buttons.js",
        "src/telegram/features/webk_buttons.js",
        "src/telegram/main.js"
      ],
      "css": [
        "src/shared/styles/content.css",
        "src/telegram/ui/styles.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://photos.google.com/*"
      ],
      "js": [
        "src/shared/utils/error_reporter.js",
        "src/shared/utils/toast_manager.js",
        "src/shared/utils/date_parser.js",
        "src/google_photos/main.js"
      ],
      "css": [
        "src/shared/styles/content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.icloud.com/*"
      ],
      "js": [
        "src/shared/utils/error_reporter.js",
        "src/shared/utils/toast_manager.js",
        "src/shared/utils/shortcut_manager.js",
        "src/shared/utils/date_parser.js",
        "src/icloud/main.js"
      ],
      "css": [
        "src/shared/styles/content.css"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Media Downloader Dev"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/x/interceptors/x_interceptor.js"
      ],
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ]
    },
    {
      "resources": [
        "src/google_photos/interceptors/google_photos_interceptor.js"
      ],
      "matches": [
        "*://photos.google.com/*"
      ]
    },
    {
      "resources": [
        "src/facebook/interceptors/fb_interceptor.js"
      ],
      "matches": [
        "*://*.facebook.com/*"
      ]
    },
    {
      "resources": [
        "src/telegram/interceptors/tg_interceptor.js"
      ],
      "matches": [
        "*://web.telegram.org/*",
        "*://webk.telegram.org/*",
        "*://webz.telegram.org/*"
      ]
    }
  ]
}
