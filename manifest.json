{
  "manifest_version": 3,
  "name": "Media Downloader Dev",
  "version": "1.0",
  "description": "Download media from Instagram, Facebook, and X directly to your PC.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://web.telegram.org/*",
    "*://webk.telegram.org/*",
    "*://webz.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/instagram/core/state.js",
        "src/instagram/core/styles.js",
        "src/instagram/core/vanish_init.js",
        "src/instagram/utils/platform.js",
        "src/instagram/ui/svgs.js",
        "src/instagram/ui/overlay_root.js",
        "src/instagram/utils/username_resolver.js",
        "src/instagram/utils/media_resolver.js",
        "src/instagram/ui/button_state.js",
        "src/instagram/features/pfp_button.js",
        "src/instagram/features/story_button.js",
        "src/instagram/features/feed_buttons.js",
        "src/instagram/features/video_progress.js",
        "src/instagram/main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "src/x/content_x_init.js",
        "src/x/x_buttons.js"
      ],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://web.telegram.org/*",
        "*://webk.telegram.org/*",
        "*://webz.telegram.org/*"
      ],
      "js": [
        "src/telegram/core/downloader.js",
        "src/telegram/ui/progress_bar.js",
        "src/telegram/features/webz_buttons.js",
        "src/telegram/features/webk_buttons.js",
        "src/telegram/main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media Downloader Dev"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vanish.js"],
      "matches": ["*://*.instagram.com/*"]
    },
    {
      "resources": ["x_interceptor.js"],
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"]
    }
  ]
}
