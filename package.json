{
  "name": "media_downloader_extension_dev",
  "version": "1.0.0",
  "description": "Media Downloader browser extension (Instagram, Facebook, X, Telegram) with a Python native host",
  "scripts": {
    "build:ig": "esbuild src/instagram/interceptors/index.js --bundle --format=iife --outfile=dist/ig_interceptor.bundle.js --minify",
    "build:features": "esbuild src/instagram/features/progress/index.js --bundle --format=iife --outfile=dist/video_progress.bundle.js --minify",
    "build": "npm run build:ig && npm run build:features",
    "watch:ig": "esbuild src/instagram/interceptors/index.js --bundle --format=iife --outfile=dist/ig_interceptor.bundle.js --watch",
    "lint": "eslint . && node tools/check_global_collisions.js .",
    "lint:strict": "eslint . --max-warnings 0",
    "audit": "node tools/code_metrics.js .",
    "test": "npm run build && node tests/run_all.mjs",
    "check": "npm run lint && npm test",
    "lint:globals": "node tools/check_global_collisions.js ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiguelAngel610/media-downloader-extension_dev.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MiguelAngel610/media-downloader-extension_dev/issues"
  },
  "homepage": "https://github.com/MiguelAngel610/media-downloader-extension_dev#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^24.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
